generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  uiTheme           String    @default("system") // dashboard theme: light | dark | system
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes  VerificationCode[]
  uploads            FileUpload[]
  notifications      Notification[]
  notifPrefs         NotificationPreferences?
  orders             Order[]
  withdrawals        Withdrawal[]
  oauthAccounts      OAuthAccount[]
  adminActions       AdminAction[]
  store              Store?
  products           Product[]
  storeOrders        StoreOrder[]
  promoCodes         PromoCode[]
  partners           Partner[]
  notificationStates NotificationState[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String @default("XOF")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Juula Store — merchant storefront.
//
// One Store per merchant (User). Holds the ad-tracking pixel IDs injected
// on every public product page (/p/[slug]).
//
// Product.config is the full `FunnelPageConfig` (src/types/juula.ts) the
// WizardEditor edits; `slug`, `status`, `price` are lifted out as columns
// so the public page can be looked up and the server can price orders
// without trusting the browser.
//
// StoreOrder is a cash-on-delivery / mobile-money lead captured on a
// public product page. Distinct from the generic `Order` (provider charge).
// Amounts are integers in FCFA.
// ───────────────────────────────────────────────────────────────────────
model Store {
  id                    String       @id @default(cuid())
  userId                String       @unique
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Public storefront: https://<subdomain>.juula.store — chosen at onboarding,
  // editable in Paramètres. Previous subdomains live in StoreAlias so links
  // already shared keep redirecting to the current one.
  name                  String?
  subdomain             String?      @unique
  logoUrl               String? // store logo / profile picture (Cloudinary)
  whatsapp              String? // support & order confirmations, E.164 without "+" (221…)
  onlineOnly            Boolean      @default(false) // no physical shop
  address               String? // physical shop address (when not online-only)
  city                  String?
  displayCurrency       String       @default("XOF") // XOF | EUR | USD — display only, charges stay in XOF
  facebookPixelId       String?
  tiktokPixelId         String?
  googleTagId           String? // Google tag / GA4 measurement id (G-XXXXXXX)
  orderCounter          Int          @default(0) // last allocated StoreOrder.number
  welcomeEmailSentAt    DateTime? // set once when the welcome email is claimed
  plan                  String       @default("FREE") // "FREE" | "PRO"
  // Payout accounts (Paramètres → Moyens de paiement). Withdrawals only go
  // to these numbers, in the legal name of the ID card.
  payoutLegalName       String?
  payoutWavePhone       String? // E.164 (+221…)
  payoutOrangePhone     String? // E.164 (+221…)
  // Storefront (<subdomain>.juula.store): draft until the merchant publishes it.
  storefrontPublished   Boolean      @default(false)
  storefrontSetupDone   Boolean      @default(false) // first-time guided setup finished
  onlinePaymentsEnabled Boolean      @default(false) // JuulaPay online payments (7,5 % per payment)
  storeTagline          String?
  storeCategory         String? // public directory category (mode, beaute, …)
  storeCoverUrl         String? // Cloudinary image
  storeAccent           String? // hex colour of buttons/badges (#RRGGBB)
  storeBanners          Json? // [{ id, imageUrl, title, badge, buttonLabel, category }]
  storeSections         Json? // [{ id, type: products|testimonials, title, subtitle, placement, productSlugs, images }]
  storeFaq              Json? // [{ id, question, answer }] — FAQ shown just before the shop footer
  announcementBar       Json? // { enabled, text, link, style, countdown: { enabled, endsAt, daily } } — top bar of the shop
  // Checkout options. COD, direct links and WhatsApp only apply to Pro stores.
  codEnabled            Boolean      @default(true)
  whatsappOrderEnabled  Boolean      @default(false)
  directPaymentMethods  Json? // [{ id, name, url, qrUrl }]
  planExpiresAt         DateTime? // null = active if PRO, or expiration date
  suspendedAt           DateTime? // set by /adminom: shop closed to buyers, whatever the plan
  suspendedReason       String?
  aliases               StoreAlias[]
  reports               Report[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model StoreSubscription {
  id                String    @id @default(cuid())
  storeId           String
  userId            String
  plan              String    @default("PRO") // PRO
  amount            Int       @default(3900) // 3 900 FCFA / mois
  currency          String    @default("FCFA")
  status            String    @default("pending") // pending | active | expired
  /// moneriz = paid online · manual = granted from /adminom (offered, cash…)
  source            String    @default("moneriz")
  /// Internal note of a manual grant (« Paiement reçu en espèces »…).
  note              String?
  providerSessionId String?   @unique
  providerPaymentId String?
  startsAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([storeId])
  @@index([userId])
}

model StoreAlias {
  subdomain String   @id
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Product {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                String    @unique
  internalName        String
  status              String    @default("draft") // draft | published | inactive
  // Disabled by /adminom (suspicious, counterfeit…): kept inactive, the
  // merchant sees the reason and cannot publish it again.
  adminDisabledAt     DateTime?
  adminDisabledReason String?
  price               Int       @default(0)
  config              Json
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders  StoreOrder[]
  events  ProductEvent[]
  reports Report[]
  drafts  CheckoutDraft[]

  @@index([userId, updatedAt])
}

/// First-party analytics of a public product page (no cookies: an anonymous
/// random visitor id kept in the browser's localStorage).
model ProductEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String // view | checkout_open
  visitorId String
  country   String? // ISO 3166-1 alpha-2 (Vercel edge header)
  source    String // facebook | instagram | tiktok | whatsapp | google | youtube | snapchat | twitter | direct | <domain>
  referrer  String? // referring host
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([productId, type, createdAt])
}

/// Order form started but not (yet) submitted — "abandoned checkout".
/// One row per visitor and product, updated as the customer types.
model CheckoutDraft {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  visitorId    String
  customerName String?
  phone        String?
  address      String?
  quantity     Int      @default(1)
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, visitorId])
  @@index([productId, updatedAt])
}

model StoreOrder {
  id                String   @id @default(cuid())
  merchantId        String
  merchant          User     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  number            Int // per-merchant sequence, formatted CMD-<storeCode>-000001
  reference         String // formatted order id shown to customer + merchant
  productName       String
  productImage      String?
  quantity          Int      @default(1)
  /// Shop cart orders: [{ productId, slug, name, image, quantity, unitPrice, lineTotal, color }].
  items             Json?
  selectedColor     String?
  amount            Int // subtotal after quantity discount
  deliveryFee       Int      @default(0)
  totalAmount       Int
  /// Promo code applied by the customer (uppercase) and what it took off totalAmount.
  promoCode         String?
  discountAmount    Int      @default(0)
  /// Affiliate link (?ref=) that brought the order, and the commission it earns (FCFA).
  partnerId         String?
  partner           Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerCommission Int      @default(0)
  currency          String   @default("FCFA")
  customerName      String
  phone             String
  whatsappNumber    String
  neighborhood      String?
  city              String?
  deliveryAddress   String?
  deliveryNotes     String?
  paymentType       String   @default("cod") // cod | online_wave | online_orange | direct
  paymentStatus     String   @default("pending_cod") // pending_cod | pending_online | pending_direct | paid | paid_direct (direct link, never in the wallet)
  paymentMethodName String? // direct payment: the merchant's method name (e.g. "Wave Business")
  status            String   @default("new") // new | confirmed | delivered | cancelled
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Online payment (Moneriz). Set only after the payment is re-verified
  // against the Moneriz API — never from client input or a raw webhook body.
  providerSessionId String?   @unique // Moneriz checkout session id (cs_…)
  providerPaymentId String?
  paidAt            DateTime?
  // paidAt + payout hold (72h): the provider settles funds after 72h, so
  // the amount only becomes withdrawable by the merchant from this date.
  availableAt       DateTime?
  netAmount         Int? // credited to the merchant wallet (totalAmount - platform commission)

  // Escrow / disputes (/adminom). A frozen order never reaches the
  // withdrawable balance, even after the 72 h hold.
  isFrozen        Boolean   @default(false)
  frozenReason    String?
  frozenAt        DateTime?
  disputeStatus   String? // frozen | refunding | released | refunded
  disputeClosedAt DateTime?
  disputeReport   String? // closing note archived with the case
  refundMethod    String? // moneriz_wave | moneriz_orange | manual
  refundPhone     String?
  refundReference String? // Moneriz withdrawal id or manual transfer reference

  @@unique([merchantId, number])
  @@index([merchantId, createdAt])
  @@index([merchantId, paymentStatus])
  @@index([disputeStatus])
}

/// Merchant notification feed state. The feed itself is derived from orders
/// and withdrawals; this only remembers what was read or deleted.
model NotificationState {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. "order:<orderId>", "paid:<orderId>", "withdrawal:<id>:COMPLETED"
  key       String
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, key])
}

// Marketing → codes promo of a merchant. Applied on product-page and shop
// orders; the discount is computed on the server and taken off totalAmount.
model PromoCode {
  id         String    @id @default(cuid())
  merchantId String
  merchant   User      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  code       String // uppercase, e.g. WELCOME10
  type       String // percent | fixed | free_shipping
  value      Int       @default(0) // percent (1-100) or FCFA amount
  minAmount  Int? // minimum subtotal in FCFA
  maxUses    Int? // total uses allowed
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([merchantId, code])
  @@index([merchantId])
}

// Marketing → liens & partenaires. An influencer shares
// https://<shop>.juula.store?ref=<slug>; orders placed within 7 days of a
// click on an active link earn a commission. The influencer follows the
// results on /partner/<id>?token=<token> (read-only, no account).
model Partner {
  id              String         @id @default(cuid())
  merchantId      String
  merchant        User           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name            String
  slug            String // lowercase, used as ?ref=<slug>
  startsAt        DateTime?
  expiresAt       DateTime
  commissionType  String // percent | fixed
  commissionValue Int // percent (1-100) or FCFA per item sold
  productSlug     String? // null = every product
  token           String         @unique // secret of the influencer dashboard
  suspended       Boolean        @default(false)
  paidAmount      Int            @default(0) // commissions already paid out
  paidAt          DateTime?
  paidVia         String? // wave | orange_money | other
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  visits          PartnerVisit[]
  orders          StoreOrder[]

  @@unique([merchantId, slug])
  @@index([merchantId])
}

// One row per visitor who came through a partner link (unique clicks).
model PartnerVisit {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([partnerId, visitorId])
}

// Public reports (« Signaler cette boutique / ce produit ») handled from
// /adminom. Target snapshots survive a deleted shop or product.
model Report {
  id             String          @id @default(cuid())
  reporterName   String
  reporterEmail  String
  reporterPhone  String
  reason         String // not_received | scam | counterfeit | dangerous | abusive | other
  description    String
  images         String[] // Cloudinary URLs (max 5)
  storeId        String?
  store          Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  storeName      String?
  storeSubdomain String?
  productTitle   String?
  productSlug    String?
  pageUrl        String?
  ip             String?
  userAgent      String?
  status         String          @default("new") // new | investigating | resolved | dismissed
  readAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       ReportMessage[]

  @@index([status, createdAt])
  @@index([storeId])
}

// E-mails exchanged about a report (sent through Resend from /adminom).
model ReportMessage {
  id             String    @id @default(cuid())
  reportId       String
  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind           String    @default("reply") // ack (automatic acknowledgement) | reply | inbound (reporter's e-mail)
  subject        String
  body           String
  status         String // sent | failed
  providerId     String?
  /// inbound only: Resend received-email id (webhook dedupe), sender, photos
  inboundEmailId String?   @unique
  fromEmail      String?
  attachments    String[]
  agent          String? // admin who sent a reply
  readAt         DateTime? // inbound: seen by the admin
  createdAt      DateTime  @default(now())

  @@index([reportId, createdAt])
}
